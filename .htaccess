# BEGIN fellowship-law-html
# Managed by .github/workflows/deploy.yml: on each deploy this block replaces
# the matching block in the server's .htaccess; rules outside it are kept.
<IfModule mod_alias.c>
Redirect 301 /home.html /index.html
</IfModule>
# Keep SiteGround's Dynamic Cache (and browsers) from serving stale pages
# after a deploy: HTML is private to the visitor and must be revalidated.
<IfModule mod_headers.c>
<FilesMatch "\.html?$">
Header set Cache-Control "private, no-cache, must-revalidate"
</FilesMatch>
</IfModule>
# END fellowship-law-html
